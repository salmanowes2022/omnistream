# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# SQLite database file (local persistent storage) - RECOMMENDED
DATABASE_URL="file:./omnistream.db"

# For in-memory database (development/testing only), comment out DATABASE_URL:
# DATABASE_URL=

# YouTube OAuth
YOUTUBE_CLIENT_ID=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
YOUTUBE_CLIENT_SECRET=112305362585-geo525oah9cvjl8blv684knnk7u36kk6.apps.googleusercontent.com
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth/youtube/callback


YOUTUBE_API_KEY=AIzaSyDNZyqfCNhtcyWScmjAMBs5OYhrcJnBOKo


# Facebook OAuth
# Create a Facebook App at https://developers.facebook.com/apps/
# Required scopes: pages_manage_posts, pages_read_engagement, pages_manage_engagement, pages_show_list, publish_video
# Note: You need a Facebook Page to stream - create one at https://www.facebook.com/pages/create
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/facebook/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/tiktok/callback

# API Security
API_KEY_SALT=your_random_salt_here
JWT_SECRET=your_jwt_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# E2E TESTING CREDENTIALS (Required for full OAuth E2E tests)
# ==============================================================================
# These credentials are ONLY needed if you want to run the full OAuth E2E test
# that validates the complete flow: community creation → OAuth to YT/FB →
# create stream → start streaming.
#
# WARNING: These will be used to actually log into test accounts during E2E tests.
# Use dedicated test accounts, NOT your personal accounts.
#
# The E2E test will be SKIPPED if these are not provided.

# Test Account Credentials for OAuth Flow
# YouTube test account (create at https://accounts.google.com)
E2E_TEST_YOUTUBE_EMAIL=
E2E_TEST_YOUTUBE_PASSWORD=

# Facebook test account (create test users at https://developers.facebook.com/apps/YOUR_APP_ID/roles/test-users/)
E2E_TEST_FACEBOOK_EMAIL=
E2E_TEST_FACEBOOK_PASSWORD=

# Optional: Skip OAuth E2E tests (set to 'true' to skip even if credentials are provided)
SKIP_OAUTH_E2E_TESTS=false
