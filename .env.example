INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/platforms/instagram/callback



# API Security
API_KEY_SALT=your_random_salt_here
JWT_SECRET=your_jwt_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# E2E TESTING CREDENTIALS (Required for full OAuth E2E tests)
# ==============================================================================
# These credentials are ONLY needed if you want to run the full OAuth E2E test
# that validates the complete flow: community creation → OAuth to YT/FB →
# create stream → start streaming.
#
# WARNING: These will be used to actually log into test accounts during E2E tests.
# Use dedicated test accounts, NOT your personal accounts.
#
# The E2E test will be SKIPPED if these are not provided.

# Test Account Credentials for OAuth Flow
# YouTube test account (create at https://accounts.google.com)
E2E_TEST_YOUTUBE_EMAIL=
E2E_TEST_YOUTUBE_PASSWORD=

# Facebook test account (create test users at https://developers.facebook.com/apps/YOUR_APP_ID/roles/test-users/)
E2E_TEST_FACEBOOK_EMAIL=
E2E_TEST_FACEBOOK_PASSWORD=

# Optional: Skip OAuth E2E tests (set to 'true' to skip even if credentials are provided)
SKIP_OAUTH_E2E_TESTS=false
