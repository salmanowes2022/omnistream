# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# SQLite database file (local persistent storage) - RECOMMENDED
DATABASE_URL="file:./omnistream.db"

# For in-memory database (development/testing only), comment out DATABASE_URL:
# DATABASE_URL=

# YouTube OAuth
YOUTUBE_CLIENT_ID=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
YOUTUBE_CLIENT_SECRET=112305362585-geo525oah9cvjl8blv684knnk7u36kk6.apps.googleusercontent.com
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/platforms/youtube/callback


YOUTUBE_API_KEY=AIzaSyDNZyqfCNhtcyWScmjAMBs5OYhrcJnBOKo


# Facebook OAuth
# Create a Facebook App at https://developers.facebook.com/apps/
# Required scopes: pages_manage_posts, pages_read_engagement, pages_manage_engagement, pages_show_list, publish_video
# Note: You need a Facebook Page to stream - create one at https://www.facebook.com/pages/create
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/platforms/facebook/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/tiktok/callback

# Twitter / X OAuth (OAuth 2.0 with PKCE)
# Create an app at https://developer.twitter.com/en/portal/dashboard
# Required scopes: tweet.read, tweet.write, users.read, offline.access
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/v1/platforms/twitter/callback

# Telegram Bot (No OAuth - Bot Token Based)
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
# Note: This is optional - users can provide their own bot tokens in the UI
TELEGRAM_BOT_TOKEN=8481681153:AAFPtzqgyBDyrFPwuEqtuQeIFvqn15BY_fQ

# Instagram OAuth (via Facebook Graph API)
# Create a Facebook App at https://developers.facebook.com/apps/
# Required scopes: instagram_basic, instagram_content_publish, pages_read_engagement, pages_show_list
# Note: Requires an Instagram Business account connected to a Facebook Page


