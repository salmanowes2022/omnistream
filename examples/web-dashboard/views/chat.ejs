<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Chat - Omnistream</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/chat.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>💬 Live Chat Monitor</h1>
            <p class="subtitle">Real-time chat from all connected platforms</p>
            <nav>
                <a href="/" class="btn btn-secondary">← Back to Dashboard</a>
            </nav>
        </header>

        <!-- Stream Selection Section -->
        <div class="section">
            <div class="card">
                <h2>Select Stream</h2>
                <div class="stream-selection">
                    <div class="form-group">
                        <label for="community-id">Community ID:</label>
                        <input type="text" id="community-id" placeholder="Enter your community ID" value="<%= typeof communityId !== 'undefined' ? communityId : '' %>" />
                    </div>
                    <div class="form-group">
                        <label for="stream-id">Stream ID:</label>
                        <input type="text" id="stream-id" placeholder="Enter stream ID" value="<%= typeof streamId !== 'undefined' ? streamId : '' %>" />
                    </div>
                    <button id="connect-btn" onclick="connectToChat()" class="btn btn-primary">Connect to Chat</button>
                    <button id="disconnect-btn" onclick="disconnectFromChat()" class="btn btn-secondary" style="display: none;">Disconnect</button>
                </div>
                <div id="connection-status" class="status-message"></div>
            </div>
        </div>

        <!-- Chat Section -->
        <div id="chat-section" class="section" style="display: none;">
            <div class="chat-container">
                <!-- Chat Messages -->
                <div class="chat-messages-panel">
                    <div class="chat-header">
                        <h3>Chat Messages</h3>
                        <div class="chat-stats">
                            <span id="message-count">0 messages</span>
                            <span id="connection-indicator" class="status-dot"></span>
                        </div>
                    </div>
                    <div id="chat-messages" class="chat-messages">
                        <div class="empty-state">
                            <p>Waiting for chat messages...</p>
                            <p class="info-text">Messages will appear here in real-time</p>
                        </div>
                    </div>

                    <!-- Send Message Section -->
                    <div class="send-message-panel">
                        <h4>Send Message</h4>
                        <div class="message-input-group">
                            <select id="send-platform" aria-label="Select platform to reply">
                                <option value="">Select platform</option>
                            </select>
                            <textarea id="message-input" placeholder="Type your message..." rows="4" onkeypress="handleMessageKeypress(event)"></textarea>
                            <button onclick="sendMessage()" class="btn btn-primary">Send</button>
                        </div>
                        <p class="info-text" style="margin-top: 5px; font-size: 0.85em;">
                            Press Enter to send, Shift+Enter for a new line. Only platforms that support replies will send successfully.
                        </p>
                    </div>
                </div>

                <!-- Platform Filter Sidebar -->
                <div class="chat-sidebar">
                    <div class="sidebar-section">
                        <h4>Platform Filters</h4>
                        <div class="platform-filters">
                            <label class="filter-checkbox">
                                <input type="checkbox" id="filter-youtube" checked onchange="togglePlatformFilter('youtube')">
                                <span class="platform-badge youtube">YouTube</span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" id="filter-telegram" checked onchange="togglePlatformFilter('telegram')">
                                <span class="platform-badge telegram">Telegram</span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" id="filter-facebook" checked onchange="togglePlatformFilter('facebook')">
                                <span class="platform-badge facebook">Facebook</span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" id="filter-twitter" checked onchange="togglePlatformFilter('twitter')">
                                <span class="platform-badge twitter">Twitter</span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" id="filter-instagram" checked onchange="togglePlatformFilter('instagram')">
                                <span class="platform-badge instagram">Instagram</span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" id="filter-tiktok" checked onchange="togglePlatformFilter('tiktok')">
                                <span class="platform-badge tiktok">TikTok</span>
                            </label>
                        </div>
                    </div>

                    <div class="sidebar-section">
                        <h4>Actions</h4>
                        <button onclick="clearChat()" class="btn btn-small">Clear Messages</button>
                        <button onclick="exportChat()" class="btn btn-small">Export Chat</button>
                    </div>

                    <div class="sidebar-section">
                        <h4>Stats</h4>
                        <div class="chat-stats-detail">
                            <div class="stat-item">
                                <span class="stat-label">YouTube:</span>
                                <span id="stat-youtube" class="stat-value">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Telegram:</span>
                                <span id="stat-telegram" class="stat-value">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Facebook:</span>
                                <span id="stat-facebook" class="stat-value">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Twitter:</span>
                                <span id="stat-twitter" class="stat-value">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Instagram:</span>
                                <span id="stat-instagram" class="stat-value">0</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">TikTok:</span>
                                <span id="stat-tiktok" class="stat-value">0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/chat.js"></script>
</body>
</html>
