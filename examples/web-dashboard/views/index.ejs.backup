<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnistream Dashboard - Multi-Platform Live Streaming</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🎥 Omnistream Dashboard</h1>
            <p class="subtitle">Multi-Platform Live Streaming Made Easy</p>
        </header>

        <!-- Authentication Section -->
        <div id="auth-section" class="section">
            <div class="card">
                <h2>Get Started</h2>
                <div class="auth-forms">
                    <div class="form-group">
                        <h3>Create New Community</h3>
                        <input type="text" id="community-name" placeholder="Community Name (e.g., Gigaverse Gaming)" />
                        <button onclick="createCommunity()" class="btn btn-primary">Create Community</button>
                        <p class="info-text" style="font-size: 0.9em; margin-top: 10px;">
                            A unique community ID will be generated automatically
                        </p>
                    </div>
                    <div class="form-group">
                        <h3>Use Existing Community ID</h3>
                        <input type="text" id="login-communityid" placeholder="Your Community ID (UUID)" />
                        <button onclick="loginWithCommunityId()" class="btn btn-primary">Login</button>
                        <p class="info-text" style="font-size: 0.9em; margin-top: 10px;">
                            Enter your existing community ID to continue
                        </p>
                    </div>
                </div>
                <div id="auth-status" class="status-message"></div>
            </div>
        </div>

        <!-- Community Profile Section -->
        <div id="profile-section" class="section" style="display: none;">
            <div class="card">
                <div class="profile-header">
                    <div>
                        <h2>Community: <span id="profile-name"></span></h2>
                        <p>Community ID: <code id="profile-id"></code></p>
                    </div>
                    <button onclick="logout()" class="btn btn-secondary">Logout</button>
                </div>
            </div>
        </div>

        <!-- Platform OAuth Section -->
        <div id="platforms-section" class="section" style="display: none;">
            <div class="card">
                <h2>🔗 Connect Streaming Platforms</h2>
                <p class="info-text">Connect your accounts to stream to multiple platforms simultaneously</p>
                <div id="platforms-grid" class="platforms-grid">
                    <!-- Platforms will be loaded dynamically -->
                </div>
                <div id="platform-status" class="status-message"></div>
            </div>
        </div>

        <!-- Stream Management Section -->
        <div id="streams-section" class="section" style="display: none;">
            <div class="card">
                <h2>📡 Stream Management</h2>

                <div class="stream-create">
                    <h3>Create New Stream</h3>
                    <input type="text" id="stream-title" placeholder="Stream Title" />
                    <textarea id="stream-description" placeholder="Stream Description"></textarea>

                    <div class="platform-selection">
                        <h4>Select Platforms:</h4>
                        <div id="platform-checkboxes"></div>
                    </div>

                    <button onclick="createStream()" class="btn btn-success">Create Stream</button>
                </div>

                <div class="streams-list">
                    <h3>Your Streams</h3>
                    <div id="streams-container"></div>
                </div>

                <div id="stream-status" class="status-message"></div>
            </div>
        </div>

        <!-- Demo Information -->
        <div id="demo-info" class="section">
            <div class="card info-card">
                <h2>💡 About This Demo</h2>
                <div class="demo-features">
                    <div class="feature">
                        <h3>🔐 Community Management</h3>
                        <p>Create and manage communities with unique IDs for organizing your streams</p>
                    </div>
                    <div class="feature">
                        <h3>🌐 OAuth Integration</h3>
                        <p>Connect YouTube, Facebook, and TikTok accounts with one click</p>
                    </div>
                    <div class="feature">
                        <h3>📺 Multi-Platform Streaming</h3>
                        <p>Create streams that broadcast to multiple platforms simultaneously</p>
                    </div>
                    <div class="feature">
                        <h3>⚡ Real-Time Control</h3>
                        <p>Start, stop, and monitor your streams with a simple UI</p>
                    </div>
                </div>

                <div class="integration-info">
                    <h3>Why Integrate Omnistream?</h3>
                    <ul>
                        <li>✅ Single API for multiple streaming platforms</li>
                        <li>✅ Simplified OAuth flow management</li>
                        <li>✅ Automatic stream key generation and distribution</li>
                        <li>✅ Real-time stream health monitoring</li>
                        <li>✅ RESTful API design for easy integration</li>
                        <li>✅ Built for Gigaverse and metaverse applications</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
